<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="540.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.my.washer.controllers.ServiceAddingController">
   <children>
      <!-- Выбор услуги -->
      <ComboBox fx:id="serviceComboBox" editable="true" layoutX="9.0" layoutY="24.0" prefHeight="25.0" prefWidth="258.0" promptText="выберите услугу" />

      <!-- Поле для скидки -->
      <Label alignment="CENTER_RIGHT" layoutX="9.0" layoutY="49.0" prefHeight="25.0" prefWidth="110.0" text="скидка">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="discountField" layoutX="119.0" layoutY="49.0" prefHeight="25.0" prefWidth="148.0" promptText="0" />

      <!-- Удаление услуги -->
      <ComboBox fx:id="removeComboBox" editable="true" layoutX="268.0" layoutY="24.0" prefHeight="25.0" prefWidth="271.0" promptText="удалить выбранную" />

      <!-- Заголовок -->
      <Label alignment="CENTER" layoutX="9.0" layoutY="74.0" prefHeight="25.0" prefWidth="523.0" text="выбранные услуги" textAlignment="CENTER">
         <font>
            <Font size="16.0" />
         </font>
      </Label>

      <!-- Список выбранных услуг -->
      <ListView fx:id="selectedServicesListView" layoutX="9.0" layoutY="99.0" prefHeight="139.0" prefWidth="258.0" />

      <!-- Список доступных услуг -->
      <ListView fx:id="availableServicesListView" layoutX="268.0" layoutY="99.0" prefHeight="139.0" prefWidth="271.0" />

      <!-- Итого -->
      <Label alignment="CENTER_RIGHT" layoutX="270.0" layoutY="245.0" prefHeight="25.0" prefWidth="134.0" text="ИТОГО">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="totalPriceField" layoutX="410.0" layoutY="245.0" prefHeight="25.0" prefWidth="128.0" editable="false" promptText="0" />

      <!-- Кнопки -->
      <Button fx:id="addToOrderButton" layoutX="182.0" layoutY="296.0" mnemonicParsing="false" onAction="#addToOrderButton" prefHeight="25.0" prefWidth="161.0" text="добавить к записи" />

      <Button fx:id="exitButton" layoutX="187.0" layoutY="338.0" mnemonicParsing="false" onAction="#exitButton" prefHeight="25.0" prefWidth="161.0" text="выйти" />
   </children>
</AnchorPane>